"AppBuild"
{
	"AppID" "DEMO_APP_ID"
	"Desc" "CrazyTower Demo"
	// the unzipped Windows demo folder (with CrazyTowerDemo.exe), relative to this file
	"ContentRoot" "content\CrazyTowerDemo\"
	"BuildOutput" "output\"
	"Depots"
	{
		"DEMO_DEPOT_ID"
		{
			"FileMapping"
			{
				"LocalPath" "*"
				"DepotPath" "."
				"recursive" "1"
			}
		}
	}
}
